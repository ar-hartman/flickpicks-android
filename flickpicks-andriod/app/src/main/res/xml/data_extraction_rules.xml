<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+.
   The token store is excluded: its values are encrypted with a device-bound Keystore key, so a
   restored or transferred copy could never be decrypted (see store/SecureStore.kt). Keep in sync
   with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="flykpicks_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="flykpicks_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
